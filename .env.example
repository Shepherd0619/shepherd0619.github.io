# CSDN Authentication Cookies
# Get these from your browser after logging into CSDN

# UUID tracking cookie
CSDN_UUID_TT_DD=your_uuid_tt_dd_value_here

# CSDN username (defaults to u012587406 if not set)
CSDN_USERNAME=u012587406

# User authentication token
CSDN_USER_TOKEN=your_user_token_value_here

# How to get these values:
# 1. Open Chrome/Edge and go to https://blog.csdn.net
# 2. Log in to your CSDN account
# 3. Press F12 to open DevTools
# 4. Go to Application tab > Cookies > https://blog.csdn.net
# 5. Find and copy the values for:
#    - uuid_tt_dd
#    - UserName
#    - UserToken
# 6. Copy this file to .env and replace the placeholder values
