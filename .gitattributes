# Images — treat as binary, never convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
blog/images/*.png filter=lfs diff=lfs merge=lfs -text
blog/images/*.jpg filter=lfs diff=lfs merge=lfs -text
blog/images/*.gif filter=lfs diff=lfs merge=lfs -text
